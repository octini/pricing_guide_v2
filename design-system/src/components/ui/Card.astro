---
// Card. Raised paper surface with the punch default voice: 2px ink
// border, 12px radius, small hard offset shadow. Wrap in
// [data-voice="quiet"] to restore the hairline border, 8px radius,
// and no shadow. Headlines inside inherit Bricolage from the base layer.
export interface Props {
  title?: string;
  eyebrow?: string;
  lift?: boolean;
}

const { title, eyebrow, lift = false } = Astro.props;
---
<article class:list={['ds-card', { 'ds-lift': lift }]}>
  {eyebrow && <p class="ds-card__eyebrow">{eyebrow}</p>}
  {title && <h3 class="ds-card__title">{title}</h3>}
  <slot />
</article>

<style>
  .ds-card {
    background-color: var(--paper-raised);
    border: var(--border-punch) solid var(--ink);
    border-radius: var(--radius-punch);
    box-shadow: 3px 3px 0 var(--ink);
    padding: 1.25rem;
    color: var(--ink);
  }
  .ds-card__eyebrow {
    margin: 0 0 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ds-card__title {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    line-height: 1.3;
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-card, .ds-card:hover, .ds-card:active { transition: none; transform: none; }
  }
</style>
