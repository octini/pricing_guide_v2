---
// Text input with label / help / error. Error voice reuses the single
// accent hue (accent-strong text + border); no second hue is introduced.
export interface Props {
  label: string;
  name: string;
  id?: string;
  type?: string;
  value?: string;
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  autocomplete?: string;
  help?: string;
  error?: string;
}

const {
  label, name, id, type = 'text', value, placeholder,
  required = false, disabled = false, autocomplete, help, error,
} = Astro.props;

const fieldId = id ?? `field-${name}`;
const helpId = `${fieldId}-help`;
const errorId = `${fieldId}-error`;
const described = [error ? errorId : null, help ? helpId : null].filter(Boolean).join(' ') || undefined;
---
<div class="ds-field">
  <label class="ds-field__label" for={fieldId}>
    {label}{required && <span class="ds-field__req" aria-hidden="true"> *</span>}
  </label>
  <input
    class:list={['ds-field__control', { 'ds-field__control--error': error }]}
    id={fieldId}
    name={name}
    type={type}
    value={value}
    placeholder={placeholder}
    required={required}
    disabled={disabled}
    autocomplete={autocomplete}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={described}
  />
  {help && !error && <p class="ds-field__help" id={helpId}>{help}</p>}
  {error && <p class="ds-field__error" id={errorId} role="alert">{error}</p>}
</div>

<style>
  .ds-field { display: grid; gap: 0.375rem; }
  .ds-field__label { font-size: 0.875rem; font-weight: 600; color: var(--ink); }
  .ds-field__req { color: var(--accent-strong); }
  .ds-field__control {
    width: 100%;
    padding: 0.5625rem 0.75rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--ink);
    background-color: var(--paper);
    border: var(--border-hairline) solid var(--border);
    border-radius: var(--radius-card);
    transition: border-color var(--motion-duration) var(--motion-ease),
      box-shadow var(--motion-duration) var(--motion-ease);
  }
  .ds-field__control::placeholder { color: var(--muted); }
  .ds-field__control:hover { border-color: var(--accent-strong); }
  .ds-field__control:focus {
    outline: none;
    border-color: var(--accent-strong);
  }
  .ds-field__control:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 1px;
  }
  .ds-field__control--error { border-color: var(--accent-strong); }
  .ds-field__control:disabled { opacity: 0.55; cursor: not-allowed; }
  .ds-field__help { margin: 0; font-size: 0.8125rem; color: var(--muted); }
  .ds-field__error { margin: 0; font-size: 0.8125rem; font-weight: 600; color: var(--accent-strong); }
  @media (prefers-reduced-motion: reduce) {
    .ds-field__control { transition: none; }
  }
</style>
