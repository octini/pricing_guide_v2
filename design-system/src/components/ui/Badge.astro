---
// Badge / Tag. One pill primitive with the punch default voice: 2px
// borders and a small hard offset shadow. Accent reads the coral tint,
// neutral the quiet hairline role, outline the strong line. Wrap in
// [data-voice="quiet"] to restore hairlines and no shadow. Tag usage =
// Badge with a leading icon or count.
import Icon, { type IconName } from './Icon.astro';

export type BadgeVariant = 'accent' | 'neutral' | 'outline';

export interface Props {
  variant?: BadgeVariant;
  icon?: IconName;
}

const { variant = 'neutral', icon } = Astro.props;
---
<span class={['ds-badge', `ds-badge--${variant}`].join(' ')}>
  {icon && <Icon name={icon} size={12} />}
  <slot />
</span>

<style>
  .ds-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.1875rem 0.625rem;
    border-radius: var(--radius-pill);
    border: var(--border-punch) solid transparent;
    box-shadow: 2px 2px 0 var(--ink);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }
  .ds-badge--accent { background-color: var(--accent-soft); color: var(--accent-strong); border-color: var(--ink); }
  .ds-badge--neutral {
    background-color: transparent;
    color: var(--muted);
    border-color: var(--ink);
  }
  .ds-badge--outline { background-color: transparent; color: var(--accent-strong); border-color: var(--ink); }
</style>
