---
// Tooltip. CSS reveal on hover + focus-within; Escape blurs the trigger.
// Inverted fill (ink bubble, paper text) keeps AA in both modes.
// Island contract (framework renderer): <Tooltip client:load text="…">…</Tooltip>
export interface Props {
  text: string;
  position?: 'top' | 'bottom';
}

const { text, position = 'top' } = Astro.props;
const tipId = `ds-tip-${Math.random().toString(36).slice(2, 8)}`;
---
<span class={['ds-tip', `ds-tip--${position}`].join(' ')}>
  <span class="ds-tip__trigger" tabindex="0" aria-describedby={tipId}>
    <slot />
  </span>
  <span class="ds-tip__bubble" id={tipId} role="tooltip">{text}</span>
</span>

<script define:vars={{ tipId }}>
  const bubble = document.getElementById(tipId);
  const trigger = bubble?.previousElementSibling;
  trigger?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') trigger.blur();
  });
</script>

<style>
  .ds-tip { position: relative; display: inline-flex; }
  .ds-tip__trigger { display: inline-flex; border-radius: var(--radius-sm); }
  .ds-tip__trigger:focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 2px; }
  .ds-tip__bubble {
    position: absolute;
    left: 50%;
    transform: translateX(-50%) translateY(2px);
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-sm);
    background-color: var(--ink);
    color: var(--paper);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }
  .ds-tip--top .ds-tip__bubble { bottom: calc(100% + 0.375rem); }
  .ds-tip--bottom .ds-tip__bubble { top: calc(100% + 0.375rem); }
  .ds-tip:hover .ds-tip__bubble,
  .ds-tip:focus-within .ds-tip__bubble {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-tip__bubble { transition: none; transform: translateX(-50%); }
  }
</style>
