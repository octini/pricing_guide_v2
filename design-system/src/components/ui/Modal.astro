---
// Modal. Native <dialog>: focus containment + Escape come from the
// platform. Triggers are [data-modal-open="<id>"], closers [data-modal-close].
// Backdrop click closes. Motion is guarded by prefers-reduced-motion.
// Island contract (framework renderer): <Modal client:load id title>…</Modal>
import Icon from './Icon.astro';

export interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const titleId = `${id}-title`;
---
<dialog class="ds-modal" id={id} aria-labelledby={titleId}>
  <div class="ds-modal__panel">
    <div class="ds-modal__head">
      <h2 class="ds-modal__title" id={titleId}>{title}</h2>
      <button type="button" class="ds-modal__close" data-modal-close aria-label="Close dialog">
        <Icon name="close" size={18} />
      </button>
    </div>
    <slot />
  </div>
</dialog>

<script define:vars={{ id }}>
  const dialog = document.getElementById(id);
  if (dialog) {
    document.querySelectorAll(`[data-modal-open="${id}"]`).forEach((trigger) => {
      trigger.addEventListener('click', () => dialog.showModal());
    });
    dialog.querySelectorAll('[data-modal-close]').forEach((closer) => {
      closer.addEventListener('click', () => dialog.close());
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .ds-modal {
    padding: 0;
    border: none;
    background: transparent;
    color: var(--ink);
  }
  .ds-modal::backdrop { background-color: color-mix(in srgb, var(--ink) 45%, transparent); }
  .ds-modal__panel {
    width: min(28rem, calc(100vw - 2rem));
    padding: 1.25rem;
    background-color: var(--paper);
    border: var(--border-hairline) solid var(--border);
    border-radius: var(--radius-slab);
    box-shadow: var(--shadow-soft);
  }
  .ds-modal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .ds-modal__title { margin: 0; font-size: 1.25rem; line-height: 1.3; }
  .ds-modal__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: var(--border-hairline) solid var(--border);
    border-radius: var(--radius-pill);
    background-color: var(--paper-raised);
    color: var(--muted);
    cursor: pointer;
    transition: color var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease);
  }
  .ds-modal__close:hover { color: var(--accent-strong); border-color: var(--accent-strong); }
  .ds-modal__close:focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .ds-modal__close { transition: none; }
  }
</style>
